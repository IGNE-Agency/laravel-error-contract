{
    "name": "igne-agency/laravel-problem-details",
    "description": "Answers every API error as RFC 9457 Problem Details, and documents those answers per endpoint when the application uses Scramble.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "require-dev": {
        "dedoc/scramble": "^0.13.52",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "conflict": {
        "dedoc/scramble": "<0.13.52 || >=0.14"
    },
    "suggest": {
        "dedoc/scramble": "Documents the Problem Details answers of each endpoint in the OpenAPI document.",
        "igne-agency/laravel-scramble-extensions": "Lets Scramble also see what the middleware of a route and the methods an action calls throw, so those errors are documented too."
    },
    "autoload": {
        "psr-4": {
            "Igne\\ProblemDetails\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Igne\\ProblemDetails\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Igne\\ProblemDetails\\ProblemDetailsServiceProvider",
                "Igne\\ProblemDetails\\OpenApi\\OpenApiServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
